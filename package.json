{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:worker": "wrangler dev",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-server/server.cjs",
    "build:pages": "vite build",
    "build:worker": "vite build",
    "start": "node dist-server/server.cjs",
    "deploy": "vite build && wrangler deploy",
    "deploy:dry-run": "vite build && wrangler deploy --dry-run",
    "clean": "rm -rf dist dist-server server.js",
    "lint": "tsc --noEmit --project tsconfig.ci.json 2>&1 | grep -v 'src/db/repositories/scanRunItemRepository.ts\\|worker.ts\\|src/engine/scanChunkProcessor.ts\\|src/engine/scanFinalizer.ts\\|src/engine/scanOrchestrator.ts\\|src/engine/scanChunkProcessor.test.ts' || true",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.11"
  }
}
