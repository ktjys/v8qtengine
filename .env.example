# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# V8_DATA_PROVIDER: 'yahoo' for live market data (default) or 'seed' for demo fixture data
V8_DATA_PROVIDER="yahoo"

# SUPABASE: Optional credentials for cloud persistence
SUPABASE_URL=""
SUPABASE_KEY=""

# TELEGRAM: Real-time signal notification webhook / bot credentials
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
